{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "binder.co.in" }], "destination": "https://www.binder.co.in/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://sooqtzedurtjiisjdmbz.supabase.co/functions/v1/sitemap" },
    { "source": "/((?!images/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(index.html|script.js|styles.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
